{
  "name": "lx-wms",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5173 --strictPort\" \"npm run dev:electron:build\" \"npm run dev:electron:run\"",
    "dev:electron:build": "tsc -p tsconfig.electron.json --watch",
    "dev:electron:run": "wait-on http://localhost:5173 && wait-on dist-electron/main.js && .\\\\node_modules\\\\.bin\\\\electron.cmd dist-electron/main.js",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron",
    "dist": "npm run build && npm run rebuild:electron && electron-builder",
    "rebuild:electron": "npm rebuild better-sqlite3 --runtime=electron --target=40.1.0 --disturl=https://electronjs.org/headers",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --environment node"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/1402771410/LX-WMS"
  },
  "author": "LX-WMS",
  "description": "离线桌面仓库管理系统",
  "build": {
    "appId": "com.lx.wms",
    "productName": "LX-WMS",
    "artifactName": "LX-WMS-Setup-${version}.exe",
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/migrations/**",
      "electron/preload.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "1402771410",
        "repo": "LX-WMS"
      }
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.2.3",
    "better-sqlite3": "^12.6.2",
    "electron-updater": "^6.7.3",
    "nodemailer": "^6.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.3"
  }
}
